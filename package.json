{
  "name": "floating-timer-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "clean": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "clean:all": "cargo clean --manifest-path src-tauri/Cargo.toml && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\"",
    "build:win": "tauri build --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^8.0.16",
    "typescript": "~6.0.3"
  }
}
